{
  "name": "ffc-doc-alerting",
  "version": "1.0.25",
  "description": "Publish alerts from Document Hub warnings",
  "homepage": "https://github.com/DEFRA/ffc-doc-alerting",
  "main": "app/index.js",
  "scripts": {
    "pretest": "npm run test:lint",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --coverage=false --onlyChanged --watch --runInBand",
    "test:lint": "eslint",
    "test:lint:fix": "eslint --fix",
    "test:debug": "node --inspect-brk=0.0.0.0 ./node_modules/jest/bin/jest.js --coverage=false --onlyChanged --watch --runInBand --no-cache",
    "start:watch": "nodemon --inspect=0.0.0.0 --ext js --legacy-watch app/index.js",
    "start:debug": "nodemon --inspect-brk=0.0.0.0 --ext js --legacy-watch app/index.js",
    "prepare": "husky"
  },
  "author": "Defra",
  "contributors": [
    "John Barnard john.barnard.external@atos.net",
    "Sam Plackett samuel.plackett@atos.net",
    "Leigh Godson leigh.godson@atos.net",
    "Alistair Wishart alistair.wishart@atos.net"
  ],
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@azure/monitor-opentelemetry": "1.18.2",
    "ffc-messaging": "2.10.8",
    "joi": "18.2.1",
    "log-timestamp": "0.3.0",
    "moment": "2.29.4",
    "notifications-node-client": "8.3.2"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "husky": "9.1.7",
    "jest": "29.6.4",
    "jest-junit": "17.0.0",
    "neostandard": "0.12.2",
    "nodemon": "3.0.1"
  },
  "overrides": {
    "@opentelemetry/propagator-jaeger": "2.9.0",
    "brace-expansion": "5.0.8"
  },
  "nodemonConfig": {
    "ignore": [
      "**/test-output/**"
    ]
  }
}
